# =============================================================
# AITC LLM 配置模板
# 复制本文件为根目录 .env 后按需修改；.env 已被 .gitignore 忽略，
# 不会提交 API 密钥。支持两种模型来源：
#   1. 本地部署大模型（vLLM / SGLang 等 OpenAI 兼容服务）
#   2. 云端 API（如 DeepSeek）
# 变量名通用：LLM_BASE_URL / LLM_MODEL_ID / LLM_API_KEY，
# 也可继续使用旧前缀 AITC_LLM_*（优先级更高）。
# =============================================================

# ---------- 方式一：本地部署大模型（vLLM/SGLang） ----------
LLM_BASE_URL="http://localhost:8000/v1"
LLM_MODEL_ID="Qwen3-0.6B"
LLM_API_KEY="EMPTY"

# ---------- 方式二：云端 API（例如 DeepSeek） ----------
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL_ID="deepseek-chat"
# LLM_API_KEY="sk-xxxxxxxxxxxxxxxx"

# ---------- 可选高级参数 ----------
# LLM_TIMEOUT_SECONDS="60"
# LLM_MAX_TOKENS="1024"
# 本地 vLLM 可开启思考模式；云端 API 若不支持请保持 false
# LLM_ENABLE_THINKING="false"
